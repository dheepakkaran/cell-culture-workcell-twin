<!-- Cell culture workcell digital twin (simulation only).
     Franka Panda (MuJoCo Menagerie, Apache-2.0) inside a box-shaped biosafety-cabinet-like hood.
     Units: metres. Robot base at the origin, facing +x. -->
<mujoco model="cell_culture_workcell">
  <include file="../assets/franka_emika_panda/panda.xml"/>
  <compiler meshdir="../assets/franka_emika_panda/assets"/>
  <option timestep="0.002"/>

  <visual>
    <headlight diffuse="0.5 0.5 0.5" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <global offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <material name="steel" rgba="0.72 0.74 0.76 1"/>
    <material name="hood_wall" rgba="0.85 0.87 0.88 1"/>
    <material name="glass" rgba="0.75 0.88 0.95 0.25"/>
    <material name="rack" rgba="0.95 0.95 0.95 1"/>
    <material name="incubator" rgba="0.55 0.58 0.62 1"/>
    <material name="flask" rgba="0.92 0.95 0.97 0.85"/>
    <material name="medium" rgba="0.95 0.62 0.68 1"/>
    <material name="cap_red" rgba="0.9 0.05 0.05 1"/>
    <material name="cap_blue" rgba="0.05 0.15 0.95 1"/>
    <material name="cap_yellow" rgba="0.95 0.85 0.05 1"/>
  </asset>

  <worldbody>
    <light name="hood_light" pos="0.4 0 1.15" dir="0 0 -1" directional="false" diffuse="0.6 0.6 0.6"/>

    <!-- Hood: work surface, back wall, side walls, ceiling, low front sash (glass hanging from the ceiling) -->
    <geom name="work_surface" type="box" pos="0.32 0 -0.01" size="0.70 0.78 0.01" material="steel"/>
    <geom name="hood_back"    type="box" pos="1.02 0 0.6"   size="0.02 0.78 0.6"  material="hood_wall"/>
    <geom name="hood_left"    type="box" pos="0.32 0.78 0.6"  size="0.70 0.02 0.6" material="hood_wall"/>
    <geom name="hood_right"   type="box" pos="0.32 -0.78 0.6" size="0.70 0.02 0.6" material="hood_wall"/>
    <geom name="hood_ceiling" type="box" pos="0.32 0 1.22"  size="0.70 0.78 0.02" material="hood_wall"/>
    <geom name="hood_sash"    type="box" pos="-0.36 0 0.92" size="0.01 0.78 0.28" material="glass"/>

    <!-- Divider panel between rack side and incubator side (makes the hood tight) -->
    <geom name="divider" type="box" pos="0.63 0 0.29" size="0.21 0.01 0.29" material="hood_wall"/>

    <!-- Flask rack (left, +y): base plate + slot dividers -->
    <body name="rack" pos="0.48 0.32 0">
      <geom name="rack_base" type="box" pos="0 0 0.015" size="0.19 0.07 0.015" material="rack"/>
      <geom name="rack_div_1" type="box" pos="-0.06 0 0.07" size="0.004 0.06 0.04" material="rack"/>
      <geom name="rack_div_2" type="box" pos="0.06 0 0.07"  size="0.004 0.06 0.04" material="rack"/>
    </body>

    <!-- Target shelf ("incubator", right, -y): solid body with a shelf top at z = 0.25 and a back lip -->
    <body name="incubator" pos="0.48 -0.32 0">
      <geom name="incubator_body" type="box" pos="0 0 0.125" size="0.20 0.09 0.125" material="incubator"/>
      <geom name="incubator_lip"  type="box" pos="0 -0.085 0.265" size="0.20 0.005 0.015" material="incubator"/>
    </body>

    <!-- Three T75-sized flasks standing upright (body 0.08 x 0.04 x 0.15 m, cap r=0.015 h=0.02) -->
    <body name="flask_A" pos="0.36 0.32 0.105">
      <freejoint name="flask_A_free"/>
      <geom name="flask_A_body" type="box" size="0.04 0.02 0.075" material="flask" mass="0.12"/>
      <geom name="flask_A_medium" type="box" pos="0 0 -0.045" size="0.038 0.018 0.028" material="medium" contype="0" conaffinity="0" mass="0.001"/>
      <geom name="flask_A_cap" type="cylinder" pos="0 0 0.085" size="0.015 0.01" material="cap_red" mass="0.005"/>
    </body>
    <body name="flask_B" pos="0.48 0.32 0.105">
      <freejoint name="flask_B_free"/>
      <geom name="flask_B_body" type="box" size="0.04 0.02 0.075" material="flask" mass="0.12"/>
      <geom name="flask_B_medium" type="box" pos="0 0 -0.045" size="0.038 0.018 0.028" material="medium" contype="0" conaffinity="0" mass="0.001"/>
      <geom name="flask_B_cap" type="cylinder" pos="0 0 0.085" size="0.015 0.01" material="cap_blue" mass="0.005"/>
    </body>
    <body name="flask_C" pos="0.60 0.32 0.105">
      <freejoint name="flask_C_free"/>
      <geom name="flask_C_body" type="box" size="0.04 0.02 0.075" material="flask" mass="0.12"/>
      <geom name="flask_C_medium" type="box" pos="0 0 -0.045" size="0.038 0.018 0.028" material="medium" contype="0" conaffinity="0" mass="0.001"/>
      <geom name="flask_C_cap" type="cylinder" pos="0 0 0.085" size="0.015 0.01" material="cap_yellow" mass="0.005"/>
    </body>

    <!-- Fixed overhead camera, looking straight down at the work surface -->
    <camera name="overhead" pos="0.50 0 1.17" xyaxes="0 -1 0 1 0 0" fovy="75"/>
  </worldbody>
</mujoco>
